# Template for كَادر / دَفتر / رِحال Vite SPAs. Copy into the app repo root
# (Coolify build context) and keep nginx.conf imported from this folder.
# Do not invent a third nginx style.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY vendor/product-shell ./vendor/product-shell
RUN npm ci
COPY . .
ARG VITE_API_BASE_URL=https://fleet-api.trugraph.io/api/v1
ARG SOURCE_COMMIT=development
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV SOURCE_COMMIT=$SOURCE_COMMIT
RUN npx vite build && printf '%s' "$SOURCE_COMMIT" > dist/commit.txt

FROM nginx:1.27-alpine
COPY --from=build /app/vendor/product-shell/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
EXPOSE 80
